# =============================================================================
# DriveXchange Parking Manager — Variables d'environnement
# Copier ce fichier en .env et renseigner toutes les valeurs avant démarrage.
# =============================================================================

NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173
TZ=Europe/Paris
LOG_LEVEL=info

DATABASE_URL=postgresql://parking:parking@localhost:5432/driveXchange?schema=public
DATABASE_POOL_SIZE=10

JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_64_chars_long
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_64_chars_long
JWT_REFRESH_EXPIRES_DAYS=30

ADMIN_JWT_SECRET=CHANGE_ME_admin_secret_at_least_64_chars_long
ADMIN_JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

FEATURE_TOTP_ENABLED=false
FEATURE_SSO_ENABLED=false

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=dxc:

VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public_key_base64url
VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private_key_base64url
VAPID_SUBJECT=mailto:admin@driveXchange.test

POSTMARK_API_KEY=CHANGE_ME_postmark_server_api_token
POSTMARK_FROM_EMAIL=parking@driveXchange.test
POSTMARK_FROM_NAME=DriveXchange Parking
EMAIL_ENABLED=false

CHECK_IN_DEADLINE_MINUTES=60
AUTO_RELEASE_MINUTES=75
DEMO_COOLDOWN_MINUTES=30
DEFAULT_SLOT_START=08:00
DEFAULT_SLOT_END=20:00
SPOT_HOLD_TTL_SECONDS=15
CHECKIN_REMINDER_MINUTES=15
DAILY_REPORT_CRON=0 7 * * *

RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=200

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

METRICS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME_metrics_token

SEED_DEFAULT_PIN=1234
SEED_ADMIN_PASSWORD=Admin123!

FLY_REGION=cdg
FLY_APP_NAME=driveXchange-parking
