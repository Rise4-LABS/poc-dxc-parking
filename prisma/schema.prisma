generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum SpotType {
  LOT1
  LOT2
  BOX
}

enum BookingStatus {
  PENDING
  HELD
  CONFIRMED
  OCCUPIED
  RELEASED
  CANCELLED
  NO_SHOW
  BLOCKED
}

enum BookingSource {
  USER
  ADMIN
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_TOKEN_REFRESHED
  USER_TOKEN_REVOKED
  ADMIN_LOGIN
  ADMIN_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  USER_PIN_RESET
  USER_ROLE_CHANGED
  BOOKING_CREATED
  BOOKING_CANCELLED
  BOOKING_CHECKIN
  BOOKING_RELEASED
  BOOKING_NO_SHOW
  BOOKING_AUTO_RELEASED
  BOOKING_HELD
  BOOKING_HOLD_EXPIRED
  RECURRING_BOOKING_CREATED
  RECURRING_BOOKING_CANCELLED
  WAITLIST_JOINED
  WAITLIST_LEFT
  WAITLIST_PROMOTED
  SPOT_BLOCKED
  SPOT_UNBLOCKED
  SETTINGS_UPDATED
  DATA_EXPORTED
  ACCOUNT_ANONYMISED
}

model User {
  id        String    @id @default(cuid())
  accessId  String    @unique @db.VarChar(6)
  name      String    @db.VarChar(100)
  email     String?   @unique @db.VarChar(255)
  pinHash   String    @db.VarChar(255)
  role      Role      @default(USER)
  locale    String    @default("fr") @db.VarChar(5)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings          Booking[]
  recurringBookings RecurringBooking[]
  waitListEntries   WaitListEntry[]
  refreshTokens     RefreshToken[]
  auditLogsAsActor  AuditLog[]             @relation("AuditActor")
  notificationPref  NotificationPreference?

  @@index([accessId])
  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Spot {
  id          String   @id @default(cuid())
  number      String   @unique @db.VarChar(10)
  label       String?  @db.VarChar(100)
  type        SpotType @default(STANDARD)
  status      String   @default("FREE") @db.VarChar(20)
  blockReason String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings          Booking[]
  recurringBookings RecurringBooking[]
  waitListEntries   WaitListEntry[]

  @@index([type])
  @@index([status])
  @@map("spots")
}

model Booking {
  id           String        @id @default(cuid())
  userId       String?
  spotId       String
  date         String        @db.VarChar(10)
  startTime    String        @db.VarChar(5)
  endTime      String?       @db.VarChar(5)    // nullable pour réservations indéfinies
  status       BookingStatus @default(CONFIRMED)
  checkedIn    Boolean       @default(false)
  checkedInAt  DateTime?
  releasedAt   DateTime?
  recurrenceId String?
  heldUntil    DateTime?
  // champs admin
  source       BookingSource @default(USER)
  vehicleLabel String?       @db.VarChar(255)
  isIndefinite Boolean       @default(false)
  adminNote    String?       @db.VarChar(1000)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  spot             Spot              @relation(fields: [spotId], references: [id])
  recurringBooking RecurringBooking? @relation(fields: [recurrenceId], references: [id])

  @@index([userId])
  @@index([spotId])
  @@index([date])
  @@index([status])
  @@index([spotId, date, status])
  @@index([heldUntil])
  @@map("bookings")
}

model RecurringBooking {
  id        String    @id @default(cuid())
  userId    String
  spotId    String
  startTime String    @db.VarChar(5)
  endTime   String    @db.VarChar(5)
  weekday   Int       @db.SmallInt
  startDate String    @db.VarChar(10)
  endDate   String?   @db.VarChar(10)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  spot     Spot      @relation(fields: [spotId], references: [id])
  bookings Booking[]

  @@index([userId])
  @@index([weekday, active])
  @@map("recurring_bookings")
}

model WaitListEntry {
  id          String    @id @default(cuid())
  userId      String
  spotId      String
  date        String    @db.VarChar(10)
  startTime   String    @db.VarChar(5)
  endTime     String    @db.VarChar(5)
  promotedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
  spot Spot @relation(fields: [spotId], references: [id])

  @@index([spotId, date])
  @@index([userId])
  @@map("wait_list_entries")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  hash      String    @unique @db.VarChar(64)
  family    String    @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([hash])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String      @id @default(cuid())
  actorId     String?
  action      AuditAction
  entityType  String?     @db.VarChar(50)
  entityId    String?     @db.VarChar(50)
  payloadJson Json?
  ipAddress   String?     @db.VarChar(45)
  createdAt   DateTime    @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model NotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  pushSubscription Json?
  emailEnabled     Boolean  @default(true)
  pushEnabled      Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model DomainEvent {
  id          String    @id @default(cuid())
  type        String    @db.VarChar(100)
  aggregateId String    @db.VarChar(50)
  payloadJson Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([processedAt])
  @@map("domain_events")
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@map("system_settings")
}
